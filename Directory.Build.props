<Project>

  <!--
    Shared build properties for all IfcToolbox projects.
    Keeping the xbim version in one place makes future schema upgrades (e.g. IFC4x3)
    a single-line change instead of one edit per project file.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <XbimVersion>6.1.605</XbimVersion>
  </PropertyGroup>

  <!--
    NuGet package metadata. Projects opt in with IsPackable=true; the license and readme
    are attached in Directory.Build.targets, which runs after each project has decided.
  -->
  <PropertyGroup>
    <Version>2.0.0-preview.2</Version>
    <Authors>Yousheng Wang and contributors</Authors>
    <Copyright>Copyright (c) 2021 Yousheng Wang and contributors</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/TrungVuDuy/tvd-ifcToolBox</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TrungVuDuy/tvd-ifcToolBox.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>IFC;BIM;openBIM;IDS;buildingSMART;IFC4x3;xbim</PackageTags>
    <IsPackable>false</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
