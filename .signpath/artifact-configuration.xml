<?xml version="1.0" encoding="utf-8"?>
<!--
  The SignPath artifact configuration for the release workflow (.github/workflows/release.yml).
  SignPath keeps its own copy: paste this file into the project's artifact configuration there,
  and change it here and there together.

  The workflow uploads the folder publish/, so the archive SignPath receives holds:
    IfcToolbox-app-win-x64/   the desktop app
    ifctoolbox-win-x64/       the command line tool, a single-file executable

  Only this project's own binaries are signed. IfcConvert_x64.exe (IfcOpenShell) and the
  Microsoft, xbim and other libraries are someone else's and keep the signature they came with.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <directory path="IfcToolbox-app-win-x64">
      <pe-file path="IfcToolbox.exe">
        <authenticode-sign />
      </pe-file>
      <pe-file-set>
        <!-- IfcToolbox.dll, IfcToolbox.Core.dll, IfcToolbox.Tools.dll, IfcToolbox.IfcConvert.dll -->
        <include path="IfcToolbox*.dll" max-matches="unbounded" />
        <for-each>
          <authenticode-sign />
        </for-each>
      </pe-file-set>
    </directory>
    <directory path="ifctoolbox-win-x64">
      <pe-file path="ifctoolbox.exe">
        <authenticode-sign />
      </pe-file>
    </directory>
  </zip-file>
</artifact-configuration>
