<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>IfcToolbox.Cli</RootNamespace>
    <!-- Help text uses the executable's name. -->
    <AssemblyName>ifctoolbox</AssemblyName>

    <!-- Installed with: dotnet tool install -g IfcToolbox.Cli -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ifctoolbox</ToolCommandName>
    <PackageId>IfcToolbox.Cli</PackageId>
    <Description>Command line IFC toolbox: validate models against IDS, convert to glTF and other formats, split IFC 4.3 infrastructure models by facility, optimise, anonymise and georeference. IFC2X3, IFC4 and IFC 4.3.</Description>
    <PackageTags>$(PackageTags);cli;dotnet-tool</PackageTags>
    <!-- LICENSE, THIRD-PARTY-NOTICES.md and licenses\ beside the exe (Directory.Build.targets). -->
    <IfcToolboxShipsNotices>true</IfcToolboxShipsNotices>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IfcToolbox.Tools\IfcToolbox.Tools.csproj" />
  </ItemGroup>

</Project>
