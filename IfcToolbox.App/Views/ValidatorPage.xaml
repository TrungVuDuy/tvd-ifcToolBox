<Page
    x:Class="IfcToolbox.App.Views.ValidatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls"
    xmlns:bsdd="using:IfcToolbox.Core.Bsdd.Models"
    xmlns:models="using:IfcToolbox.App.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller">
            <StackPanel Padding="36,28,36,12" Spacing="12">
                <controls:PageHeader x:Name="Header" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />

                <controls:Section Header="File to validate">
                    <controls:FileDropZone x:Name="ModelZone" FilesChanged="OnInputChanged" />
                </controls:Section>

                <controls:Section Header="Requirements">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="IdsMode" GroupName="RequirementSource" Style="{StaticResource ModeTileStyle}" IsChecked="True" Checked="OnModeChanged"
                                         AutomationProperties.Name="IDS file">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                        <TextBlock Text="IDS file" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                               Text="Requirements in an Information Delivery Specification (IDS 1.0), written in any IDS tool." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="BsddMode" Grid.Column="1" GroupName="RequirementSource" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged"
                                         AutomationProperties.Name="bSDD">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE774;" FontSize="16" />
                                        <TextBlock Text="buildingSMART Data Dictionary" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                               Text="Pick classes and their properties from bSDD. Needs an internet connection." />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <!-- IDS file -->
                        <controls:FileDropZone x:Name="IdsZone" AllowMultiple="True" Prompt="Choose IDS files or drop them here" FilesChanged="OnInputChanged" />

                        <!-- bSDD -->
                        <StackPanel x:Name="BsddPanel" Spacing="12" Visibility="Collapsed">
                            <InfoBar x:Name="BsddError" Severity="Error" Title="bSDD could not be reached" IsOpen="False" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Choose a bSDD dictionary" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox x:Name="DictionaryChoice" MinWidth="420" PlaceholderText="Loading dictionaries…" IsEnabled="False"
                                              SelectionChanged="OnDictionaryChanged" AutomationProperties.Name="bSDD dictionary">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:DictionaryOption">
                                                <TextBlock Text="{x:Bind Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ProgressRing x:Name="DictionaryProgress" Width="20" Height="20" IsActive="False" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Search classifications and properties for validation" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <AutoSuggestBox x:Name="SearchBox" MinWidth="420" PlaceholderText="Search classes, e.g. wall" QueryIcon="Find"
                                                    QuerySubmitted="OnSearch" AutomationProperties.Name="Search classes" />
                                    <Button Content="Search" Click="OnSearchClick" AutomationProperties.Name="Search bSDD" />
                                    <ProgressRing x:Name="SearchProgress" Width="20" Height="20" IsActive="False" />
                                </StackPanel>
                                <ListView x:Name="SearchResults" MaxHeight="260" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAddClass"
                                          Visibility="Collapsed" AutomationProperties.Name="Search results">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="bsdd:BsddClassSearchItem">
                                            <Grid Padding="0,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock>
                                                        <Run Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                        <Run Text="{x:Bind ReferenceCode}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryCaptionStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <FontIcon Grid.Column="1" Glyph="&#xE710;" FontSize="14" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="SearchEmptyText" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Requirements to check" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                        <HyperlinkButton x:Name="SaveIdsButton" Content="Save as IDS…" Click="OnSaveIds" IsEnabled="False" />
                                        <HyperlinkButton x:Name="ClearClassesButton" Content="Clear" Click="OnClearClasses" IsEnabled="False" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="NoClassesText" Style="{StaticResource SecondaryTextStyle}"
                                           Text="Search above and pick a class. Its property sets appear here: tick the properties every matching object must have." />
                                <ProgressRing x:Name="ClassProgress" Width="20" Height="20" IsActive="False" HorizontalAlignment="Left" />
                                <TreeView x:Name="RequirementTree" SelectionMode="Multiple" Visibility="Collapsed" MaxHeight="420"
                                          SelectionChanged="OnRequirementSelectionChanged" AutomationProperties.Name="Requirements to check" />
                                <CheckBox x:Name="AllowedValuesCheck" Content="Also check values against the allowed values listed in bSDD" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Name="ResultsSection" Header="Results" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <controls:IdsResultsView x:Name="ResultsView" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnExportCsv">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9F9;" FontSize="14" />
                                    <TextBlock Text="Export CSV" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnExportText">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock Text="Export text report" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </controls:Section>
            </StackPanel>
        </ScrollViewer>

        <controls:RunBar x:Name="RunBar" Grid.Row="1" ActionText="Validate IFC" Run="OnValidate" />
    </Grid>
</Page>
