<Page
    x:Class="IfcToolbox.App.Views.ValidatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls"
    xmlns:bsdd="using:IfcToolbox.Core.Bsdd.Models"
    xmlns:models="using:IfcToolbox.App.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller">
            <StackPanel Padding="36,28,36,12" Spacing="12">
                <controls:PageHeader x:Name="Header" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />

                <controls:Section x:Uid="Validator_File">
                    <controls:FileDropZone x:Name="ModelZone" FilesChanged="OnInputChanged" />
                </controls:Section>

                <controls:Section x:Uid="Validator_Requirements">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="IdsMode" GroupName="RequirementSource" Style="{StaticResource ModeTileStyle}" IsChecked="True" Checked="OnModeChanged"
                                         x:Uid="Validator_IdsMode">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                        <TextBlock x:Uid="Validator_IdsModeTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Uid="Validator_IdsModeText" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="BsddMode" Grid.Column="1" GroupName="RequirementSource" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged"
                                         x:Uid="Validator_BsddMode">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE774;" FontSize="16" />
                                        <TextBlock Text="buildingSMART Data Dictionary" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Uid="Validator_BsddModeText" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <!-- IDS file -->
                        <controls:FileDropZone x:Name="IdsZone" AllowMultiple="True" x:Uid="Validator_IdsZone" FilesChanged="OnInputChanged" />

                        <!-- bSDD -->
                        <StackPanel x:Name="BsddPanel" Spacing="12" Visibility="Collapsed">
                            <InfoBar x:Name="BsddError" x:Uid="Validator_BsddError" Severity="Error" IsOpen="False" />

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Validator_ChooseDictionary" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox x:Name="DictionaryChoice" MinWidth="420" IsEnabled="False" x:Uid="Validator_Dictionary"
                                              SelectionChanged="OnDictionaryChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:DictionaryOption">
                                                <TextBlock Text="{x:Bind Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ProgressRing x:Name="DictionaryProgress" Width="20" Height="20" IsActive="False" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Validator_SearchTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <AutoSuggestBox x:Name="SearchBox" MinWidth="420" QueryIcon="Find" x:Uid="Validator_SearchBox"
                                                    QuerySubmitted="OnSearch" />
                                    <Button x:Uid="Validator_SearchButton" Click="OnSearchClick" />
                                    <ProgressRing x:Name="SearchProgress" Width="20" Height="20" IsActive="False" />
                                </StackPanel>
                                <ListView x:Name="SearchResults" MaxHeight="260" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAddClass"
                                          Visibility="Collapsed" x:Uid="Validator_SearchResults">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="bsdd:BsddClassSearchItem">
                                            <Grid Padding="0,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock>
                                                        <Run Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                        <Run Text="{x:Bind ReferenceCode}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryCaptionStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <FontIcon Grid.Column="1" Glyph="&#xE710;" FontSize="14" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="SearchEmptyText" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock x:Uid="Validator_ToCheck" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                        <HyperlinkButton x:Name="SaveIdsButton" x:Uid="Validator_SaveIds" Click="OnSaveIds" IsEnabled="False" />
                                        <HyperlinkButton x:Name="ClearClassesButton" x:Uid="Validator_ClearClasses" Click="OnClearClasses" IsEnabled="False" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="NoClassesText" x:Uid="Validator_NoClasses" Style="{StaticResource SecondaryTextStyle}" />
                                <ProgressRing x:Name="ClassProgress" Width="20" Height="20" IsActive="False" HorizontalAlignment="Left" />
                                <TreeView x:Name="RequirementTree" SelectionMode="Multiple" Visibility="Collapsed" MaxHeight="420"
                                          SelectionChanged="OnRequirementSelectionChanged" x:Uid="Validator_RequirementTree" />
                                <CheckBox x:Name="AllowedValuesCheck" x:Uid="Validator_AllowedValues" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Name="ResultsSection" x:Uid="Validator_Results" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <controls:IdsResultsView x:Name="ResultsView" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnExportCsv">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9F9;" FontSize="14" />
                                    <TextBlock x:Uid="Validator_ExportCsv" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnExportText">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock x:Uid="Validator_ExportText" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </controls:Section>
            </StackPanel>
        </ScrollViewer>

        <controls:RunBar x:Name="RunBar" Grid.Row="1" Run="OnValidate" />
    </Grid>
</Page>
