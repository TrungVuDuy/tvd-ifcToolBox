<Page
    x:Class="IfcToolbox.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <Page.Resources>
        <Style x:Key="DependencyNameStyle" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="36,28" Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <controls:PageHeader Title="About" Glyph="&#xE946;" TileBrush="{StaticResource HeaderTileBrush}" Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                <Image Source="ms-appx:///Assets/AppLogo.png" Width="64" Height="64" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="IFC Toolbox" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Simple tools for processing IFC files." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <controls:Section Header="This version">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap">
                        This is a modified continuation of IFC Toolbox by Yousheng Wang, which is no longer maintained.
                        It moves the app from UWP to WinUI 3 and the tools to .NET 8 and xbim 6, and adds IDS 1.0
                        validation, IFC 4.3 support, glTF output and a new bSDD client.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        Credit for the original app, its design and its tools goes to its author and everyone who helped with it.
                        The Microsoft Store app and its releases belong to the original project.
                    </TextBlock>
                    <HyperlinkButton Content="Original IFC Toolbox on GitHub" NavigateUri="https://github.com/youshengCode/IfcToolbox" Padding="0" />
                </StackPanel>
            </controls:Section>

            <controls:Section Header="Dependencies and References">
                <Grid x:Name="DependencyGrid" ColumnSpacing="24" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </controls:Section>

            <controls:Section Header="Privacy">
                <TextBlock TextWrapping="Wrap">
                    IFC Toolbox works on your files on this computer and does not collect usage data. Only the bSDD features go
                    online: they send what you search for to the buildingSMART Data Dictionary service.
                </TextBlock>
            </controls:Section>

            <controls:Section Header="Disclaimer">
                <TextBlock TextWrapping="Wrap">
                    This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the
                    implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. Check the files it produces before
                    relying on them. See the GNU General Public License for more details.
                </TextBlock>
            </controls:Section>

            <controls:Section Header="License">
                <StackPanel Spacing="4">
                    <TextBlock Text="GNU General Public License v3.0" />
                    <TextBlock Text="Copyright (c) 2021 Yousheng Wang. Modifications from 2026 by their respective contributors." TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton Content="Read the license" NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html" Padding="0" />
                </StackPanel>
            </controls:Section>
        </StackPanel>
    </ScrollViewer>
</Page>
