<Page
    x:Class="IfcToolbox.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <Page.Resources>
        <Style x:Key="DependencyNameStyle" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="36,28" Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <controls:PageHeader x:Uid="About_Header" Glyph="&#xE946;" TileBrush="{StaticResource HeaderTileBrush}" Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                <Image Source="ms-appx:///Assets/AppLogo.png" Width="64" Height="64" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="IFC Toolbox" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="About_Tagline" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <controls:Section x:Uid="About_ThisVersion">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="About_Continuation" TextWrapping="Wrap" />
                    <TextBlock x:Uid="About_Credit" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Uid="About_ThisRepo" NavigateUri="https://github.com/TrungVuDuy/tvd-ifcToolBox" Padding="0" />
                    <HyperlinkButton x:Uid="About_OriginalRepo" NavigateUri="https://github.com/youshengCode/IfcToolbox" Padding="0" />
                </StackPanel>
            </controls:Section>

            <controls:Section x:Uid="About_Dependencies">
                <Grid x:Name="DependencyGrid" ColumnSpacing="24" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </controls:Section>

            <controls:Section x:Uid="About_Privacy">
                <TextBlock x:Uid="About_PrivacyText" TextWrapping="Wrap" />
            </controls:Section>

            <controls:Section x:Uid="About_Disclaimer">
                <TextBlock x:Uid="About_DisclaimerText" TextWrapping="Wrap" />
            </controls:Section>

            <controls:Section x:Uid="About_License">
                <StackPanel Spacing="4">
                    <TextBlock Text="GNU General Public License v3.0" />
                    <TextBlock x:Uid="About_Copyright" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Uid="About_ReadLicense" Click="OnOpenLicense" Tag="LICENSE.txt" Padding="0" />
                    <HyperlinkButton x:Uid="About_Notices" Click="OnOpenLicense" Tag="THIRD-PARTY-NOTICES.md" Padding="0" />
                </StackPanel>
            </controls:Section>
        </StackPanel>
    </ScrollViewer>
</Page>
