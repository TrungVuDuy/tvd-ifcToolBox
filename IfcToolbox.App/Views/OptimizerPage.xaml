<Page
    x:Class="IfcToolbox.App.Views.OptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="36,28,36,12" Spacing="12">
                <controls:PageHeader x:Name="Header" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />

                <controls:Section x:Uid="Optimizer_Files">
                    <controls:FileDropZone x:Name="ModelZone" AllowMultiple="True" FilesChanged="OnFilesChanged" />
                </controls:Section>

                <controls:Section x:Uid="Optimizer_Configuration">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Optimizer_General" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                <TextBlock x:Uid="Optimizer_SchemaSupport" />
                                <TextBlock x:Uid="Optimizer_Schemas" Style="{StaticResource SecondaryCaptionStyle}" Margin="0,0,0,6" />
                                <ToggleSwitch x:Name="KeepLabelSwitch" x:Uid="Optimizer_KeepLabel" />
                                <TextBlock x:Uid="Optimizer_KeepLabelNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Optimizer_MergeTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                <ToggleSwitch x:Name="MergeSwitch" x:Uid="Optimizer_Merge" IsOn="True" Toggled="OnOptionChanged" />
                                <RadioButtons x:Name="MergeChoice" SelectedIndex="1">
                                    <RadioButton x:Uid="Optimizer_MergeResources" />
                                    <RadioButton x:Uid="Optimizer_MergeAll" />
                                </RadioButtons>
                                <TextBlock x:Uid="Optimizer_MergeNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Optimizer_FprTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                <ToggleSwitch x:Name="RoundSwitch" x:Uid="Optimizer_Round" Toggled="OnOptionChanged" />
                                <StackPanel x:Name="PrecisionPanel" Spacing="2">
                                    <Slider x:Name="PrecisionSlider" x:Uid="Optimizer_Precision" Minimum="1" Maximum="12" Value="6" StepFrequency="1"
                                            TickFrequency="1" TickPlacement="BottomRight" ValueChanged="OnPrecisionChanged" MaxWidth="420" HorizontalAlignment="Left" Width="420" />
                                    <TextBlock x:Name="PrecisionText" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PointSwitch" x:Uid="Optimizer_Points" IsOn="True" Toggled="OnOptionChanged" />
                                <TextBlock x:Uid="Optimizer_PointsNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="PointListSwitch" x:Uid="Optimizer_PointLists" IsOn="True" Toggled="OnOptionChanged" />
                                <TextBlock x:Uid="Optimizer_PointListsNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </controls:Section>

                <controls:Section x:Name="OutputSection" x:Uid="Optimizer_Output" Visibility="Collapsed">
                    <controls:OutputFilesView x:Name="OutputView" />
                </controls:Section>
            </StackPanel>
        </ScrollViewer>

        <controls:RunBar x:Name="RunBar" Grid.Row="1" Run="OnOptimize" />
    </Grid>
</Page>
