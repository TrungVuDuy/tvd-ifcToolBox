<Page
    x:Class="IfcToolbox.App.Views.RelocatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <Page.Resources>
        <!-- A row of a placement card: label left, value right. -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style x:Key="CoordinateBoxStyle" TargetType="NumberBox">
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="36,28,36,12" Spacing="12">
                <controls:PageHeader x:Name="Header" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />

                <controls:Section x:Uid="Relocator_File">
                    <StackPanel Spacing="12">
                        <controls:FileDropZone x:Name="ModelZone" FilesChanged="OnModelChanged" />
                        <ProgressRing x:Name="AnalysisProgress" Width="24" Height="24" IsActive="False" HorizontalAlignment="Left" />
                        <!-- Where the model is now. Filled in code, the same layout as the reference model's. -->
                        <Grid x:Name="CurrentPanel" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed" />
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Name="TargetSection" x:Uid="Relocator_Target">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="AlignMode" GroupName="Target" Style="{StaticResource ModeTileStyle}" IsChecked="True" Checked="OnModeChanged" x:Uid="Relocator_AlignMode">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8AB;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"><TextBlock x:Uid="Relocator_AlignModeTitle" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Uid="Relocator_AlignModeHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="ManualMode" Grid.Column="1" GroupName="Target" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" x:Uid="Relocator_ManualMode">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE70F;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"><TextBlock x:Uid="Relocator_ManualModeTitle" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Uid="Relocator_ManualModeHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="GeorefMode" Grid.Column="2" GroupName="Target" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" x:Uid="Relocator_GeorefMode">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE909;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"><TextBlock x:Uid="Relocator_GeorefModeTitle" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="GeorefHint" x:Uid="Relocator_GeorefModeHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="UnitMode" Grid.Column="3" GroupName="Target" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" x:Uid="Relocator_UnitMode">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8EF;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"><TextBlock x:Uid="Relocator_UnitModeTitle" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Uid="Relocator_UnitModeHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                                </Grid>
                            </RadioButton>
                        </Grid>

                        <!-- Change length unit -->
                        <Border x:Name="UnitPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Relocator_UnitTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                <TextBlock x:Name="UnitHint" Style="{StaticResource SecondaryTextStyle}" />
                                <RadioButtons x:Name="UnitChoice" x:Uid="Relocator_UnitChoice" SelectedIndex="2" SelectionChanged="OnUnitChanged">
                                    <RadioButton x:Uid="Relocator_UnitMm" />
                                    <RadioButton x:Uid="Relocator_UnitCm" />
                                    <RadioButton x:Uid="Relocator_UnitM" />
                                </RadioButtons>
                                <TextBlock x:Uid="Relocator_UnitNoteText" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Align to another model -->
                        <StackPanel x:Name="AlignPanel" Spacing="8">
                            <controls:FileDropZone x:Name="ReferenceZone" x:Uid="Relocator_ReferenceZone" FilesChanged="OnReferenceChanged" />
                            <ProgressRing x:Name="ReferenceProgress" Width="20" Height="20" IsActive="False" HorizontalAlignment="Left" />
                            <Grid x:Name="ReferencePanel" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed" />
                            <CheckBox x:Name="AlignWorldCheck" x:Uid="Relocator_AlignWorld" IsChecked="True" Checked="OnTargetChanged" Unchecked="OnTargetChanged" />
                            <CheckBox x:Name="AlignProjectCheck" x:Uid="Relocator_AlignProject" IsChecked="True" Checked="OnTargetChanged" Unchecked="OnTargetChanged" />
                        </StackPanel>

                        <!-- Enter placement -->
                        <Grid x:Name="ManualPanel" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Relocator_WorldTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                    <CheckBox x:Name="WorldCheck" x:Uid="Relocator_WorldCheck" Checked="OnTargetChanged" Unchecked="OnTargetChanged" />
                                    <StackPanel x:Name="WorldInputs" Orientation="Horizontal" Spacing="8">
                                        <NumberBox x:Name="WorldX" x:Uid="Relocator_WorldX" Style="{StaticResource CoordinateBoxStyle}" />
                                        <NumberBox x:Name="WorldY" x:Uid="Relocator_WorldY" Style="{StaticResource CoordinateBoxStyle}" />
                                        <NumberBox x:Name="WorldZ" x:Uid="Relocator_WorldZ" Style="{StaticResource CoordinateBoxStyle}" />
                                    </StackPanel>
                                    <NumberBox x:Name="WorldRotation" x:Uid="Relocator_WorldRotation" Style="{StaticResource CoordinateBoxStyle}" HorizontalAlignment="Left" Width="260" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Relocator_ProjectTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                    <CheckBox x:Name="ProjectCheck" x:Uid="Relocator_ProjectCheck" IsChecked="True" Checked="OnTargetChanged" Unchecked="OnTargetChanged" />
                                    <StackPanel x:Name="ProjectInputs" Orientation="Horizontal" Spacing="8">
                                        <NumberBox x:Name="ProjectX" x:Uid="Relocator_ProjectX" Style="{StaticResource CoordinateBoxStyle}" />
                                        <NumberBox x:Name="ProjectY" x:Uid="Relocator_ProjectY" Style="{StaticResource CoordinateBoxStyle}" />
                                        <NumberBox x:Name="ProjectZ" x:Uid="Relocator_ProjectZ" Style="{StaticResource CoordinateBoxStyle}" />
                                    </StackPanel>
                                    <NumberBox x:Name="ProjectRotation" x:Uid="Relocator_ProjectRotation" Style="{StaticResource CoordinateBoxStyle}" HorizontalAlignment="Left" Width="260" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Georeference -->
                        <Border x:Name="GeorefPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Relocator_MapTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                <TextBlock x:Uid="Relocator_MapNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                                <TextBox x:Name="CrsBox" x:Uid="Relocator_Crs" Width="260" HorizontalAlignment="Left" TextChanged="OnCrsChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="EastingsBox" x:Uid="Relocator_Eastings" Style="{StaticResource CoordinateBoxStyle}" MinWidth="160" ValueChanged="OnGeorefValueChanged" />
                                    <NumberBox x:Name="NorthingsBox" x:Uid="Relocator_Northings" Style="{StaticResource CoordinateBoxStyle}" MinWidth="160" ValueChanged="OnGeorefValueChanged" />
                                    <NumberBox x:Name="HeightBox" x:Uid="Relocator_Height" Style="{StaticResource CoordinateBoxStyle}" MinWidth="140" Value="0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="MapRotationBox" x:Uid="Relocator_MapRotation" Style="{StaticResource CoordinateBoxStyle}" MinWidth="200" Value="0" />
                                    <NumberBox x:Name="ScaleBox" x:Uid="Relocator_Scale" Style="{StaticResource CoordinateBoxStyle}" MinWidth="200" />
                                    <NumberBox x:Name="FactorBox" x:Uid="Relocator_Factor" Style="{StaticResource CoordinateBoxStyle}" MinWidth="180" />
                                </StackPanel>
                                <TextBlock x:Name="ScaleHint" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Name="OutputSection" x:Uid="Relocator_Output" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <controls:OutputFilesView x:Name="OutputView" />
                        <TextBlock x:Uid="Relocator_ResultTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid x:Name="ResultPanel" ColumnSpacing="12" RowSpacing="12" />
                    </StackPanel>
                </controls:Section>
            </StackPanel>
        </ScrollViewer>

        <controls:RunBar x:Name="RunBar" Grid.Row="1" Run="OnRelocate" />
    </Grid>
</Page>
