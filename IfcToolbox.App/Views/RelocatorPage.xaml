<Page
    x:Class="IfcToolbox.App.Views.RelocatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <Page.Resources>
        <!-- A row of a placement card: label left, value right. -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style x:Key="CoordinateBoxStyle" TargetType="NumberBox">
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="36,28,36,12" Spacing="12">
                <controls:PageHeader x:Name="Header" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />

                <controls:Section Header="File to relocate">
                    <StackPanel Spacing="12">
                        <controls:FileDropZone x:Name="ModelZone" FilesChanged="OnModelChanged" />
                        <ProgressRing x:Name="AnalysisProgress" Width="24" Height="24" IsActive="False" HorizontalAlignment="Left" />
                        <!-- Where the model is now. Filled in code, the same layout as the reference model's. -->
                        <Grid x:Name="CurrentPanel" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed" />
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Name="TargetSection" Header="Get target placement">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="AlignMode" GroupName="Target" Style="{StaticResource ModeTileStyle}" IsChecked="True" Checked="OnModeChanged" AutomationProperties.Name="Align to another model">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8AB;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"><TextBlock Text="Align to another model" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="Take the placement from another file" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="ManualMode" Grid.Column="1" GroupName="Target" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" AutomationProperties.Name="Enter placement">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE70F;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"><TextBlock Text="Enter placement" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="Type the new origin and rotation" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="GeorefMode" Grid.Column="2" GroupName="Target" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" AutomationProperties.Name="Georeference">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE909;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"><TextBlock Text="Georeference" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="GeorefHint" Text="Projected CRS and map conversion" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                                </Grid>
                            </RadioButton>
                        </Grid>

                        <!-- Align to another model -->
                        <StackPanel x:Name="AlignPanel" Spacing="8">
                            <controls:FileDropZone x:Name="ReferenceZone" Prompt="Choose the model to align to, or drop it here" FilesChanged="OnReferenceChanged" />
                            <ProgressRing x:Name="ReferenceProgress" Width="20" Height="20" IsActive="False" HorizontalAlignment="Left" />
                            <Grid x:Name="ReferencePanel" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed" />
                            <CheckBox x:Name="AlignWorldCheck" Content="Take its world coordinate system (IfcProject)" IsChecked="True" Checked="OnTargetChanged" Unchecked="OnTargetChanged" />
                            <CheckBox x:Name="AlignProjectCheck" Content="Take its project coordinate system (IfcSite placement)" IsChecked="True" Checked="OnTargetChanged" Unchecked="OnTargetChanged" />
                        </StackPanel>

                        <!-- Enter placement -->
                        <Grid x:Name="ManualPanel" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <Border Style="{StaticResource CardTitleStyle}"><TextBlock Text="World coordinates location" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                    <CheckBox x:Name="WorldCheck" Content="Change the world coordinate system" Checked="OnTargetChanged" Unchecked="OnTargetChanged" />
                                    <StackPanel x:Name="WorldInputs" Orientation="Horizontal" Spacing="8">
                                        <NumberBox x:Name="WorldX" Header="X" AutomationProperties.Name="World X" Style="{StaticResource CoordinateBoxStyle}" />
                                        <NumberBox x:Name="WorldY" Header="Y" AutomationProperties.Name="World Y" Style="{StaticResource CoordinateBoxStyle}" />
                                        <NumberBox x:Name="WorldZ" Header="Z" AutomationProperties.Name="World Z" Style="{StaticResource CoordinateBoxStyle}" />
                                    </StackPanel>
                                    <NumberBox x:Name="WorldRotation" Header="Rotation about Z, degrees anti-clockwise" AutomationProperties.Name="World rotation" Style="{StaticResource CoordinateBoxStyle}" HorizontalAlignment="Left" Width="260" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <Border Style="{StaticResource CardTitleStyle}"><TextBlock Text="Project coordinates location" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                    <CheckBox x:Name="ProjectCheck" Content="Change the site placement" IsChecked="True" Checked="OnTargetChanged" Unchecked="OnTargetChanged" />
                                    <StackPanel x:Name="ProjectInputs" Orientation="Horizontal" Spacing="8">
                                        <NumberBox x:Name="ProjectX" Header="X" AutomationProperties.Name="Project X" Style="{StaticResource CoordinateBoxStyle}" />
                                        <NumberBox x:Name="ProjectY" Header="Y" AutomationProperties.Name="Project Y" Style="{StaticResource CoordinateBoxStyle}" />
                                        <NumberBox x:Name="ProjectZ" Header="Z" AutomationProperties.Name="Project Z" Style="{StaticResource CoordinateBoxStyle}" />
                                    </StackPanel>
                                    <NumberBox x:Name="ProjectRotation" Header="Rotation about Z, degrees anti-clockwise" AutomationProperties.Name="Project rotation" Style="{StaticResource CoordinateBoxStyle}" HorizontalAlignment="Left" Width="260" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Georeference -->
                        <Border x:Name="GeorefPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <Border Style="{StaticResource CardTitleStyle}"><TextBlock Text="Map conversion" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap"
                                           Text="Where the model's local origin lies on a projected map (IfcProjectedCRS and IfcMapConversion). The model's geometry is not moved." />
                                <TextBox x:Name="CrsBox" Header="Projected CRS, e.g. EPSG:25832" AutomationProperties.Name="Projected CRS" Width="260" HorizontalAlignment="Left" TextChanged="OnCrsChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="EastingsBox" Header="Eastings of the origin" AutomationProperties.Name="Eastings" Style="{StaticResource CoordinateBoxStyle}" MinWidth="160" ValueChanged="OnGeorefValueChanged" />
                                    <NumberBox x:Name="NorthingsBox" Header="Northings of the origin" AutomationProperties.Name="Northings" Style="{StaticResource CoordinateBoxStyle}" MinWidth="160" ValueChanged="OnGeorefValueChanged" />
                                    <NumberBox x:Name="HeightBox" Header="Orthogonal height" Style="{StaticResource CoordinateBoxStyle}" MinWidth="140" Value="0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="MapRotationBox" Header="Rotation of x from east, degrees" Style="{StaticResource CoordinateBoxStyle}" MinWidth="200" Value="0" />
                                    <NumberBox x:Name="ScaleBox" Header="Scale (model unit to map unit)" Style="{StaticResource CoordinateBoxStyle}" MinWidth="200" />
                                    <NumberBox x:Name="FactorBox" Header="Scale factor, IFC 4.3 only" Style="{StaticResource CoordinateBoxStyle}" MinWidth="180" PlaceholderText="none" />
                                </StackPanel>
                                <TextBlock x:Name="ScaleHint" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Name="OutputSection" Header="Relocated file" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <controls:OutputFilesView x:Name="OutputView" />
                        <TextBlock Text="Placement of the new file" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid x:Name="ResultPanel" ColumnSpacing="12" RowSpacing="12" />
                    </StackPanel>
                </controls:Section>
            </StackPanel>
        </ScrollViewer>

        <controls:RunBar x:Name="RunBar" Grid.Row="1" ActionText="Relocate IFC" Run="OnRelocate" />
    </Grid>
</Page>
