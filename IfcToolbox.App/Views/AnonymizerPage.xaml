<Page
    x:Class="IfcToolbox.App.Views.AnonymizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls"
    xmlns:models="using:IfcToolbox.App.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="36,28,36,12" Spacing="12">
                <controls:PageHeader x:Name="Header" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />

                <controls:Section x:Uid="Anonymizer_File">
                    <controls:FileDropZone x:Name="ModelZone" FilesChanged="OnModelChanged" />
                </controls:Section>

                <controls:Section x:Uid="Anonymizer_User">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <ToggleSwitch x:Name="UserSwitch" x:Uid="Anonymizer_UserSwitch" IsOn="True" Toggled="OnOptionChanged" />
                            <TextBlock x:Uid="Anonymizer_UserNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                            <VariableSizedWrapGrid x:Name="UserOptions" Orientation="Horizontal" ItemWidth="340" Margin="0,4,0,0">
                                <CheckBox x:Name="PersonCheck" x:Uid="Anonymizer_PersonCheck" IsChecked="True" />
                                <CheckBox x:Name="OrganizationCheck" x:Uid="Anonymizer_OrganizationCheck" IsChecked="True" />
                                <CheckBox x:Name="PersonAndOrganizationCheck" x:Uid="Anonymizer_PersonAndOrganizationCheck" IsChecked="True" />
                                <CheckBox x:Name="ActorRoleCheck" x:Uid="Anonymizer_ActorRoleCheck" IsChecked="True" />
                                <CheckBox x:Name="PostalCheck" x:Uid="Anonymizer_PostalCheck" IsChecked="True" />
                                <CheckBox x:Name="TelecomCheck" x:Uid="Anonymizer_TelecomCheck" IsChecked="True" />
                                <CheckBox x:Name="ApplicationCheck" x:Uid="Anonymizer_ApplicationCheck" IsChecked="True" />
                                <CheckBox x:Name="FileNameCheck" x:Uid="Anonymizer_FileNameCheck" IsChecked="True" />
                            </VariableSizedWrapGrid>
                        </StackPanel>
                    </Border>
                </controls:Section>

                <controls:Section x:Uid="Anonymizer_Products">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <ToggleSwitch x:Name="ProductSwitch" x:Uid="Anonymizer_ProductSwitch" Toggled="OnOptionChanged" />
                                <TextBlock x:Uid="Anonymizer_ProductNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                                <StackPanel x:Name="ReplaceWhere" Orientation="Horizontal" Spacing="16">
                                    <CheckBox x:Name="InNameCheck" x:Uid="Anonymizer_InNameCheck" IsChecked="True" />
                                    <CheckBox x:Name="InObjectTypeCheck" x:Uid="Anonymizer_InObjectTypeCheck" IsChecked="True" />
                                    <CheckBox x:Name="InTypePropsCheck" x:Uid="Anonymizer_InTypePropsCheck" IsChecked="True" />
                                    <CheckBox x:Name="InProductPropsCheck" x:Uid="Anonymizer_InProductPropsCheck" IsChecked="True" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="ProductPanel" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Anonymizer_TypesTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                    <TextBlock x:Name="TypesHint" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                                    <ProgressRing x:Name="TypesProgress" Width="20" Height="20" IsActive="False" HorizontalAlignment="Left" />
                                    <TreeView x:Name="TypeTree" x:Uid="Anonymizer_TypeTree" SelectionMode="Multiple" MaxHeight="420" />
                                    <Button x:Name="AddRulesButton" x:Uid="Anonymizer_AddRulesButton" Click="OnAddRules" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            <TextBlock x:Uid="Anonymizer_AddRules" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Anonymizer_RulesTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                        <HyperlinkButton x:Name="ClearRulesButton" x:Uid="Anonymizer_ClearRules" HorizontalAlignment="Right" Click="OnClearRules" IsEnabled="False" />
                                    </Grid>
                                    <TextBlock x:Name="RulesHint" x:Uid="Anonymizer_RulesHint" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Anonymizer_ColumnClass" Style="{StaticResource SecondaryCaptionStyle}" />
                                        <TextBlock Grid.Column="1" x:Uid="Anonymizer_ColumnFind" Style="{StaticResource SecondaryCaptionStyle}" />
                                        <TextBlock Grid.Column="2" x:Uid="Anonymizer_ColumnReplace" Style="{StaticResource SecondaryCaptionStyle}" />
                                    </Grid>
                                    <ItemsControl x:Name="RuleList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ReplaceRule">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind EntityType}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Uid="Anonymizer_FindBox" />
                                                    <TextBox Grid.Column="2" Text="{x:Bind Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Uid="Anonymizer_ReplaceBox" />
                                                    <Button Grid.Column="3" Click="OnRemoveRule" Tag="{x:Bind}" Background="Transparent" BorderThickness="0" Padding="6"
                                                            x:Uid="Anonymizer_RemoveRule" AutomationProperties.Name="{x:Bind models:ImportedFile.Label('Anonymizer_RemoveRuleName', Keyword), Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Name="OutputSection" x:Uid="Anonymizer_Output" Visibility="Collapsed">
                    <controls:OutputFilesView x:Name="OutputView" />
                </controls:Section>
            </StackPanel>
        </ScrollViewer>

        <controls:RunBar x:Name="RunBar" Grid.Row="1" Run="OnAnonymize" />
    </Grid>
</Page>
