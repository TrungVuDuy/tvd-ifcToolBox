<Page
    x:Class="IfcToolbox.App.Views.ConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="36,28,36,12" Spacing="12">
                <controls:PageHeader x:Name="Header" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />

                <controls:Section x:Uid="Converter_Files">
                    <StackPanel Spacing="8">
                        <controls:FileDropZone x:Name="ModelZone" AllowMultiple="True" FilesChanged="OnFilesChanged" />
                        <InfoBar x:Name="SchemaWarning" Severity="Warning" IsOpen="False" IsClosable="False" x:Uid="Converter_SchemaWarning" />
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Uid="Converter_Format">
                    <StackPanel Spacing="8">
                        <!-- Tiles are generated from the formats IfcConvert knows. -->
                        <Grid x:Name="FormatGrid" ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryCaptionStyle}" />
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Uid="Converter_Filter">
                    <StackPanel Spacing="8">
                        <ToggleSwitch x:Name="FilterSwitch" x:Uid="Converter_FilterSwitch" Toggled="OnFilterToggled" />
                        <ProgressRing x:Name="ClassProgress" Width="20" Height="20" IsActive="False" HorizontalAlignment="Left" />
                        <VariableSizedWrapGrid x:Name="ClassList" Orientation="Horizontal" ItemWidth="250" Visibility="Collapsed" />
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Uid="Converter_Options">
                    <Grid ColumnSpacing="24" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <RadioButtons x:Name="NamingChoice" x:Uid="Converter_Naming" SelectedIndex="0">
                            <RadioButton x:Uid="Converter_NamingIds" />
                            <RadioButton x:Uid="Converter_NamingGuids" />
                            <RadioButton x:Uid="Converter_NamingNames" />
                        </RadioButtons>
                        <RadioButtons x:Name="PlacementChoice" x:Uid="Converter_Placement" Grid.Column="1" SelectedIndex="0">
                            <RadioButton x:Uid="Converter_PlacementGlobal" />
                            <RadioButton x:Uid="Converter_PlacementSite" />
                            <RadioButton x:Uid="Converter_PlacementBuilding" />
                        </RadioButtons>

                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock x:Uid="Converter_Geometry" />
                            <CheckBox x:Name="WorldCoordsCheck" x:Uid="Converter_WorldCoords" />
                            <CheckBox x:Name="CenterCheck" x:Uid="Converter_Center" />
                        </StackPanel>
                        <TextBlock x:Uid="Converter_OptionsNote" Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Top" />
                    </Grid>
                </controls:Section>

                <controls:Section x:Name="OutputSection" x:Uid="Converter_Output" Visibility="Collapsed">
                    <controls:OutputFilesView x:Name="OutputView" />
                </controls:Section>
            </StackPanel>
        </ScrollViewer>

        <controls:RunBar x:Name="RunBar" Grid.Row="1" Run="OnConvert" />
    </Grid>
</Page>
