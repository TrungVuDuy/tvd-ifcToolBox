<Page
    x:Class="IfcToolbox.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <ScrollViewer>
        <StackPanel Padding="36,28" Spacing="12">
            <controls:PageHeader x:Uid="Settings_Header" Glyph="&#xE713;" TileBrush="{StaticResource HeaderTileBrush}" Margin="0,0,0,12" />

            <controls:Section x:Uid="Settings_Themes">
                <RadioButtons x:Name="ThemeChoice" SelectionChanged="OnThemeChanged">
                    <RadioButton x:Uid="Settings_ThemeLight" />
                    <RadioButton x:Uid="Settings_ThemeDark" />
                    <RadioButton x:Uid="Settings_ThemeSystem" />
                </RadioButtons>
            </controls:Section>

            <controls:Section x:Uid="Settings_Languages">
                <StackPanel Spacing="8">
                    <ComboBox x:Name="LanguageChoice" x:Uid="Settings_Language" MinWidth="240" SelectionChanged="OnLanguageChanged" />
                    <StackPanel x:Name="RestartPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Uid="Settings_RestartNote" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                        <Button x:Uid="Settings_RestartNow" Click="OnRestart" />
                    </StackPanel>
                </StackPanel>
            </controls:Section>

            <controls:Section x:Uid="Settings_IfcConvert">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Settings_IfcConvertIntro" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock x:Name="IfcConvertText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Settings_PickIfcConvert" Click="OnPickIfcConvert" />
                        <Button x:Name="BundledIfcConvertButton" x:Uid="Settings_BundledIfcConvert" Click="OnBundledIfcConvert" />
                    </StackPanel>
                    <InfoBar x:Name="IfcConvertError" x:Uid="Settings_IfcConvertError" Severity="Error" IsOpen="False" />
                </StackPanel>
            </controls:Section>

            <controls:Section x:Uid="Settings_Storage">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button x:Name="ClearCacheButton" x:Uid="Settings_ClearCache" Click="OnClearCache" />
                    <TextBlock x:Name="CacheText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </controls:Section>

            <controls:Section x:Uid="Settings_Help">
                <StackPanel HorizontalAlignment="Left">
                    <HyperlinkButton x:Uid="Settings_HelpDocs" NavigateUri="https://youshengcode.github.io/IfcToolbox.Doc/#/" />
                    <HyperlinkButton x:Name="SettingsFolderLink" x:Uid="Settings_OpenFolder" Click="OnOpenSettingsFolder" />
                </StackPanel>
            </controls:Section>
        </StackPanel>
    </ScrollViewer>
</Page>
