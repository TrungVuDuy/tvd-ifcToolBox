<Page
    x:Class="IfcToolbox.App.Views.CombinerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="36,28,36,12" Spacing="12">
                <controls:PageHeader x:Name="Header" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />

                <controls:Section x:Uid="Combiner_Files">
                    <StackPanel Spacing="8">
                        <controls:FileDropZone x:Name="ModelZone" AllowMultiple="True" FilesChanged="OnFilesChanged" />
                        <TextBlock x:Uid="Combiner_BaseNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                        <InfoBar x:Name="SchemaWarning" Severity="Error" IsOpen="False" IsClosable="False" x:Uid="Combiner_SchemaWarning" />
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Uid="Combiner_Configuration">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Combiner_SpatialTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                <ToggleSwitch x:Name="ByNameSwitch" x:Uid="Combiner_ByName" IsOn="True" />
                                <TextBlock x:Uid="Combiner_ByNameNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Combiner_UnitsTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                <ToggleSwitch x:Name="UnitsSwitch" x:Uid="Combiner_Units" IsOn="True" />
                                <TextBlock x:Uid="Combiner_UnitsNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource CardTitleStyle}"><TextBlock x:Uid="Combiner_SharedTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" /></Border>
                                <ToggleSwitch x:Name="SkipSwitch" x:Uid="Combiner_Skip" IsOn="True" />
                                <TextBlock x:Uid="Combiner_SkipNote" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </controls:Section>

                <controls:Section x:Name="OutputSection" x:Uid="Combiner_Output" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <controls:OutputFilesView x:Name="OutputView" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel x:Name="ReportPanel" Spacing="6" />
                        </Border>
                    </StackPanel>
                </controls:Section>
            </StackPanel>
        </ScrollViewer>

        <controls:RunBar x:Name="RunBar" Grid.Row="1" Run="OnCombine" />
    </Grid>
</Page>
