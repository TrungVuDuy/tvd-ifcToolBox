<Page
    x:Class="IfcToolbox.App.Views.SplitterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <Page.Resources>
        <!-- Icon, title and one line of explanation inside a mode tile. -->
        <Style x:Key="TileTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="36,28,36,12" Spacing="12">
                <controls:PageHeader x:Name="Header" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />

                <controls:Section Header="File to split">
                    <controls:FileDropZone x:Name="ModelZone" FilesChanged="OnModelChanged" />
                </controls:Section>

                <controls:Section Header="Choose split mode">
                    <Grid x:Name="ModeGrid" ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <RadioButton x:Name="ByProduct" Tag="ByProduct" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" IsChecked="True" Checked="OnModeChanged" AutomationProperties.Name="Split by object">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8FD;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="Split by object" Style="{StaticResource TileTitleStyle}" /><TextBlock Text="The products you pick" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ByObjectType" Grid.Column="1" Tag="ByObjectType" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" AutomationProperties.Name="Split by type">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8F1;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="Split by type" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="ByObjectTypeHint" Text="Products by object type" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="DataOnly" Grid.Column="2" Tag="DataOnly" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" AutomationProperties.Name="Split data only">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="Split data only" Style="{StaticResource TileTitleStyle}" /><TextBlock Text="Everything except the geometry" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="BySite" Grid.Row="1" Tag="BySite" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" AutomationProperties.Name="Split by site">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE909;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="Split by site" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="BySiteHint" Text="Spatial element: IfcSite" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ByBuilding" Grid.Row="1" Grid.Column="1" Tag="ByBuilding" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" AutomationProperties.Name="Split by building">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE80F;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="Split by building" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="ByBuildingHint" Text="Spatial element: IfcBuilding" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ByBuildingStorey" Grid.Row="1" Grid.Column="2" Tag="ByBuildingStorey" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" AutomationProperties.Name="Split by level">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE81E;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="Split by level" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="ByBuildingStoreyHint" Text="Spatial element: IfcBuildingStorey" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="ByFacility" Grid.Row="2" Tag="ByFacility" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" AutomationProperties.Name="Split by facility">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE804;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="Split by facility" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="ByFacilityHint" Text="IFC 4.3: road, railway, bridge, marine" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ByFacilityPart" Grid.Row="2" Grid.Column="1" Tag="ByFacilityPart" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" AutomationProperties.Name="Split by facility part">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A9;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock Text="Split by facility part" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="ByFacilityPartHint" Text="IFC 4.3: carriageway, track, deck…" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                    </Grid>
                </controls:Section>

                <controls:Section x:Name="PickSection" Header="Pick what to extract">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PickHint" Style="{StaticResource SecondaryTextStyle}" />
                        <ProgressRing x:Name="AnalysisProgress" Width="24" Height="24" IsActive="False" HorizontalAlignment="Left" />
                        <TreeView x:Name="PickTree" SelectionMode="Multiple" MaxHeight="520" AutomationProperties.Name="What to extract" />
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Name="OutputSection" Header="Split files" Visibility="Collapsed">
                    <controls:OutputFilesView x:Name="OutputView" />
                </controls:Section>
            </StackPanel>
        </ScrollViewer>

        <controls:RunBar x:Name="RunBar" Grid.Row="1" ActionText="Split IFC" Run="OnSplit" />
    </Grid>
</Page>
