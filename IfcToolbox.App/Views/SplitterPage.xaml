<Page
    x:Class="IfcToolbox.App.Views.SplitterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <Page.Resources>
        <!-- Icon, title and one line of explanation inside a mode tile. -->
        <Style x:Key="TileTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="36,28,36,12" Spacing="12">
                <controls:PageHeader x:Name="Header" Margin="0,0,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />

                <controls:Section x:Uid="Splitter_File">
                    <controls:FileDropZone x:Name="ModelZone" FilesChanged="OnModelChanged" />
                </controls:Section>

                <controls:Section x:Uid="Splitter_Mode">
                    <Grid x:Name="ModeGrid" ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <RadioButton x:Name="ByProduct" Tag="ByProduct" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" IsChecked="True" Checked="OnModeChanged" x:Uid="Splitter_ByProduct">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8FD;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock x:Uid="Splitter_ByProductTitle" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Uid="Splitter_ByProductHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ByObjectType" Grid.Column="1" Tag="ByObjectType" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" x:Uid="Splitter_ByObjectType">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8F1;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock x:Uid="Splitter_ByObjectTypeTitle" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="ByObjectTypeHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="DataOnly" Grid.Column="2" Tag="DataOnly" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" x:Uid="Splitter_DataOnly">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock x:Uid="Splitter_DataOnlyTitle" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Uid="Splitter_DataOnlyHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="BySite" Grid.Row="1" Tag="BySite" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" x:Uid="Splitter_BySite">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE909;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock x:Uid="Splitter_BySiteTitle" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="BySiteHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ByBuilding" Grid.Row="1" Grid.Column="1" Tag="ByBuilding" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" x:Uid="Splitter_ByBuilding">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE80F;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock x:Uid="Splitter_ByBuildingTitle" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="ByBuildingHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ByBuildingStorey" Grid.Row="1" Grid.Column="2" Tag="ByBuildingStorey" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" x:Uid="Splitter_ByBuildingStorey">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE81E;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock x:Uid="Splitter_ByBuildingStoreyTitle" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="ByBuildingStoreyHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="ByFacility" Grid.Row="2" Tag="ByFacility" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" x:Uid="Splitter_ByFacility">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE804;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock x:Uid="Splitter_ByFacilityTitle" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="ByFacilityHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ByFacilityPart" Grid.Row="2" Grid.Column="1" Tag="ByFacilityPart" GroupName="SplitMode" Style="{StaticResource ModeTileStyle}" Checked="OnModeChanged" x:Uid="Splitter_ByFacilityPart">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A9;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock x:Uid="Splitter_ByFacilityPartTitle" Style="{StaticResource TileTitleStyle}" /><TextBlock x:Name="ByFacilityPartHint" Style="{StaticResource SecondaryCaptionStyle}" /></StackPanel>
                            </Grid>
                        </RadioButton>
                    </Grid>
                </controls:Section>

                <controls:Section x:Name="PickSection" x:Uid="Splitter_Pick">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PickHint" Style="{StaticResource SecondaryTextStyle}" />
                        <ProgressRing x:Name="AnalysisProgress" Width="24" Height="24" IsActive="False" HorizontalAlignment="Left" />
                        <TreeView x:Name="PickTree" SelectionMode="Multiple" MaxHeight="520" x:Uid="Splitter_PickTree" />
                    </StackPanel>
                </controls:Section>

                <controls:Section x:Name="OutputSection" x:Uid="Splitter_Output" Visibility="Collapsed">
                    <controls:OutputFilesView x:Name="OutputView" />
                </controls:Section>
            </StackPanel>
        </ScrollViewer>

        <controls:RunBar x:Name="RunBar" Grid.Row="1" Run="OnSplit" />
    </Grid>
</Page>
