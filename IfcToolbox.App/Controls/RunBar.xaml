<UserControl
    x:Class="IfcToolbox.App.Controls.RunBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bottom of a tool page: what is going on, and the red button that runs the tool. -->
    <Grid Margin="36,0,36,24" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="4">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" />
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}" />
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>
        <Button x:Name="CancelButton" x:Uid="Run_Cancel" Grid.Column="1" Click="OnCancel" Visibility="Collapsed" VerticalAlignment="Bottom" />
        <Button x:Name="ActionButton" Grid.Column="2" Padding="28,8" VerticalAlignment="Bottom"
                Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnRun" />
    </Grid>
</UserControl>
