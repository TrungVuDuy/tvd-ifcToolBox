<UserControl
    x:Class="IfcToolbox.App.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Coloured icon tile and page title, as at the top of every page of the original app. -->
    <StackPanel Orientation="Horizontal" Spacing="14">
        <Border Width="40" Height="40" CornerRadius="8" Background="{x:Bind TileBrush, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="20" Foreground="White" />
        </Border>
        <TextBlock VerticalAlignment="Center" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
    </StackPanel>
</UserControl>
