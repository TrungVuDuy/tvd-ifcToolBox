<UserControl
    x:Class="IfcToolbox.App.Controls.OutputFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IfcToolbox.App.Models">

    <!-- Files a tool wrote, each with a way to open it or find it. -->
    <StackPanel Spacing="8">
        <InfoBar x:Name="Summary" IsOpen="True" IsClosable="False" Severity="Success" />
        <ItemsControl x:Name="FileList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ImportedFile">
                    <Grid Padding="12,8" ColumnSpacing="16" CornerRadius="4" Background="{ThemeResource FileRowBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="20" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind Folder}" Style="{StaticResource SecondaryCaptionStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Size}" Style="{StaticResource SecondaryTextStyle}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Button Click="OnOpen" Tag="{x:Bind Path}" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Open" AutomationProperties.Name="{x:Bind models:ImportedFile.Label('Open', Name)}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            </Button>
                            <Button Click="OnShowInFolder" Tag="{x:Bind Path}" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Show in folder" AutomationProperties.Name="{x:Bind models:ImportedFile.Label('Show in folder', Name)}">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
