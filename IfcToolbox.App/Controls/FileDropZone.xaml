<UserControl
    x:Class="IfcToolbox.App.Controls.FileDropZone"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IfcToolbox.App.Models"
    xmlns:local="using:IfcToolbox.App.Controls">

    <UserControl.Resources>
        <!-- The dashed "Choose files or Drop files here" area of the original app. -->
        <ControlTemplate x:Key="DropZoneTemplate" TargetType="Button">
            <Grid x:Name="Root" Background="{ThemeResource DropZoneBrush}" CornerRadius="4">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="Root.Background" Value="{ThemeResource DropZoneHoverBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="Root.Background" Value="{ThemeResource DropZoneHoverBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Target="Root.Opacity" Value="0.5" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Rectangle Stroke="{ThemeResource DropZoneStrokeBrush}"
                           StrokeThickness="1.5"
                           StrokeDashArray="4,3"
                           RadiusX="4"
                           RadiusY="4" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <Button x:Name="ZoneButton"
                Height="112"
                HorizontalAlignment="Stretch"
                Template="{StaticResource DropZoneTemplate}"
                AllowDrop="True"
                Click="OnChooseFiles"
                DragOver="OnDragOver"
                DragLeave="OnDragLeave"
                Drop="OnDrop"
                x:Uid="Drop_Zone">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon FontSize="16" Glyph="{StaticResource GlyphAdd}" />
                <TextBlock x:Name="PromptText" Text="{x:Bind Prompt, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Button>

        <ItemsControl x:Name="FileList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ImportedFile">
                    <Grid Padding="12,8" ColumnSpacing="16" CornerRadius="4" Background="{ThemeResource FileRowBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{StaticResource GlyphDocument}" FontSize="22" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Folder}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                            <TextBlock Text="{x:Bind Problem, Mode=OneWay}" Visibility="{x:Bind local:FileDropZone.ShowIf(Problem), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,2" CornerRadius="10" Background="{ThemeResource SchemaBadgeBrush}">
                            <TextBlock Text="{x:Bind Badge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SchemaBadgeForegroundBrush}" />
                        </Border>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Modified}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{x:Bind Size}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="5" Click="OnMoveUp" Tag="{x:Bind}" Background="Transparent" BorderThickness="0"
                                Visibility="{x:Bind local:FileDropZone.ShowIfTrue(CanMoveUp), Mode=OneWay}"
                                x:Uid="Row_MoveUp" AutomationProperties.Name="{x:Bind models:ImportedFile.Label('Row_MoveUpName', Name)}">
                            <FontIcon Glyph="&#xE70E;" FontSize="14" />
                        </Button>
                        <Button Grid.Column="6" Click="OnRemoveFile" Tag="{x:Bind}" Background="Transparent" BorderThickness="0"
                                x:Uid="Row_Remove" AutomationProperties.Name="{x:Bind models:ImportedFile.Label('Row_RemoveName', Name)}">
                            <FontIcon Glyph="{StaticResource GlyphDelete}" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <HyperlinkButton x:Name="ResetButton" HorizontalAlignment="Right" Click="OnReset" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="{StaticResource GlyphReset}" FontSize="12" />
                <TextBlock x:Uid="Drop_Reset" />
            </StackPanel>
        </HyperlinkButton>
    </StackPanel>
</UserControl>
