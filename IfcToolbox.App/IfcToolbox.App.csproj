<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Desktop app, the successor of the original UWP IFC Toolbox. WinUI 3 (Windows App SDK)
    is the direct descendant of the UWP + WinUI 2 stack the original was built on.
    Unpackaged and self-contained: it runs as a plain exe, without MSIX or an installed runtime.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>IfcToolbox.App</RootNamespace>
    <AssemblyName>IfcToolbox</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Still needed unpackaged: without it dotnet publish leaves out the app's .pri and assets. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!--
      The app's own text is in Strings\{language}\Resources.resw and goes into IfcToolbox.pri, not
      into .NET satellite assemblies; this only keeps the libraries' satellite assemblies out.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- LICENSE, THIRD-PARTY-NOTICES.md and licenses beside the exe (Directory.Build.targets). -->
    <IfcToolboxShipsNotices>true</IfcToolboxShipsNotices>
    <!--
      MVVMTK0045: [ObservableProperty] on fields is not AOT compatible for WinRT; the fix is
      partial properties, which need C# 13 and so the .NET 9 SDK. The app is published without
      AOT or trimming, so the fields are fine; revisit when moving to a newer SDK.
    -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- WinUI 2.3.9 asks for 2.1.8, which nuget.org does not have; 2.1.9 is what resolves anyway (NU1603). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IfcToolbox.Tools\IfcToolbox.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
