<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IfcToolbox.App.Controls">

    <Style TargetType="controls:Section">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Section">
                    <StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ExpandStates">
                                <VisualState x:Name="Expanded" />
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="Body.Visibility" Value="Collapsed" />
                                        <Setter Target="Chevron.Glyph" Value="&#xE70D;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Button x:Name="HeaderButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,0"
                                MinHeight="40"
                                CornerRadius="4"
                                BorderThickness="0"
                                Background="{ThemeResource SectionHeaderBrush}"
                                AutomationProperties.Name="{TemplateBinding Header}">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#CBCBCB" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C2C2C2" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Dark">
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#333333" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3A3A3A" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                            <Grid>
                                <TextBlock Text="{TemplateBinding Header}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <FontIcon x:Name="Chevron"
                                          HorizontalAlignment="Right"
                                          FontSize="12"
                                          Glyph="&#xE70E;" />
                            </Grid>
                        </Button>

                        <ContentPresenter x:Name="Body"
                                          Margin="0,12,0,24"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
