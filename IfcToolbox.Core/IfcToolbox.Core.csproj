<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Convert\Resources\IfcConvert_x32.exe" />
    <None Remove="Convert\Resources\IfcConvert_x64.exe" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Convert\Resources\IfcConvert_x32.exe" />
    <EmbeddedResource Include="Convert\Resources\IfcConvert_x64.exe" />
  </ItemGroup>

  <ItemGroup>
    <!-- RestSharp is pinned to the last 106.x release: the generated bSDD client in
         Bsdd/ targets that API surface. It goes away with the bSDD rewrite. -->
    <PackageReference Include="RestSharp" Version="106.15.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Xbim.Essentials" Version="$(XbimVersion)" />
  </ItemGroup>

</Project>
