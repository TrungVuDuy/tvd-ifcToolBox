<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Convert\Resources\IfcConvert_x32.exe" />
    <None Remove="Convert\Resources\IfcConvert_x64.exe" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Convert\Resources\IfcConvert_x32.exe" />
    <EmbeddedResource Include="Convert\Resources\IfcConvert_x64.exe" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bSDD client uses HttpClient + System.Text.Json, both in-box on net8,
         so RestSharp and Newtonsoft.Json are no longer needed. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Xbim.Essentials" Version="$(XbimVersion)" />
  </ItemGroup>

</Project>
